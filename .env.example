# Base de données de production (Postgres : Neon, Supabase…). Laissez vide en développement :
# l'appli utilise alors une base Postgres embarquée dans .data/pglite.
DATABASE_URL=

# Abonnement des menuisiers (lib/billing.ts). Laissez BILLING vide : l'application reste gratuite.
# « on » : après la période d'essai, créer un devis demande un abonnement payé par mobile money,
# le menuisier déclare son code de transfert (/abonnement) et l'équipe confirme dans /admin/paiements.
BILLING=
BILLING_MONTHLY_AR=50000
BILLING_TRIAL_DAYS=30
# Numéros qui reçoivent les paiements, affichés au menuisier
PAY_TO="MVola 034 00 000 00 · Orange Money 032 00 000 00"
